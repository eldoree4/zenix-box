# Salin ke .env untuk build lokal. Jangan masukkan secret ke Git atau ke variabel EXPO_PUBLIC_*.
# Nilai ID aplikasi bukan secret, tetapi harus unik dan dikontrol oleh pemilik aplikasi.
EAS_PROJECT_ID=
ANDROID_PACKAGE=
IOS_BUNDLE_IDENTIFIER=
ANDROID_VERSION_CODE=1
IOS_BUILD_NUMBER=1

# Kredensial layanan hanya disimpan di backend/server, bukan di aplikasi mobile.
# AI_BACKEND_URL=
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_PATH=
# APP_STORE_CONNECT_API_KEY_ID=
# APP_STORE_CONNECT_ISSUER_ID=
# APP_STORE_CONNECT_API_KEY_PATH=
